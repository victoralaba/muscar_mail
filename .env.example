# -----------------------------------------------------------------------------
# muscar_mail — Environment Configuration Template
# -----------------------------------------------------------------------------

# Runtime Environment (production | development)
ENVIRONMENT=production
DEBUG=false

# Server Bind Configuration (Render binds to $PORT dynamically)
HOST=0.0.0.0
PORT=8000

# Verifalia API v2.4 Credentials
# Obtain from your Verifalia dashboard: https://verifalia.com/client-area
VERIFALIA_USERNAME=your_verifalia_username
VERIFALIA_PASSWORD=your_verifalia_password
VERIFALIA_BASE_URL=https://api.verifalia.com/v2.4
VERIFALIA_WAIT_TIME_MS=30000

# Model Context Protocol (MCP) API Keys
# Comma-separated list of valid keys authorized to invoke the MCP endpoint
MCP_API_KEYS=key1,key2_secret

# Optional Redis Connection URL (Upstash Redis, Render Key-Value, or Redis Cloud)
# Format: rediss://default:password@hostname:port
# If omitted or unavailable, the application gracefully fails open.
REDIS_URL=

# Optional Sentry DSN for error telemetry
# If omitted, telemetry fails open silently without crashing startup.
SENTRY_DSN=
